# APP_ORIGIN=http://127.0.0.1:3000
# Teaching profile: absolute path. Run pnpm demo:seed once the catalog is installed.
# DEMO_DATA_DIR=/absolute/path/to/bookstore-demo

# Release profile with the read-only catalog contract.
# JAVA_CONTRACT=v1-catalog
# JAVA_CATALOG_BASE_URL=http://127.0.0.1:8081
# CATALOG_CATEGORIES_JSON=["Architecture","Programming"]
# JAVA_CATALOG_TOKEN=

# Release profile with the integrated Java catalog, orders, and Keycloak.
# APP_ORIGIN=http://localhost:3000
# JAVA_CONTRACT=v2-integrated
# JAVA_CATALOG_BASE_URL=http://127.0.0.1:8081
# JAVA_ORDER_BASE_URL=http://127.0.0.1:8082
# AUTH_DATABASE_URL=postgresql://bookstore:password@localhost:5432/frontend
# OIDC_ISSUER=http://localhost:8180/realms/bookstore
# Defaults to OIDC_ISSUER. The Compose stack sets the private realm URL below.
# OIDC_INTERNAL_BASE_URL=http://keycloak:8080/realms/bookstore
# OIDC_CLIENT_ID=bookstore-bff
# OIDC_CLIENT_SECRET=
