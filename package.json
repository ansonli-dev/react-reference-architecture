{
  "type": "module",
  "name": "react-reference-architecture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-app.mjs dev release",
    "build": "node scripts/run-app.mjs build release",
    "start": "node scripts/run-app.mjs start release",
    "lint": "eslint",
    "typecheck": "node scripts/run-app.mjs typegen release && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:architecture",
    "dev:mock": "node scripts/run-app.mjs dev demo",
    "dev:real": "node scripts/run-app.mjs dev release",
    "build:demo": "node scripts/run-app.mjs build demo",
    "start:demo": "node scripts/run-app.mjs start demo",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:java": "playwright test --config playwright.java.config.ts",
    "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
    "demo:seed": "node scripts/demo-seed.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  }
}
